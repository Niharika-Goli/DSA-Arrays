//Minimum element in array.
#include <bits/stdc++.h>

int main() {
    // Write C++ code here
    int arr[5];
    for (int i=0;i<5;i++){
        std::cin>>arr[i];
    }
    int min=arr[0];
    for (int i=0;i<5;i++){
        if (min>arr[i]){
            min=arr[i];
        }
    }
    std :: cout<<min;

    return 0;
}
