//even,odd elements count 
#include <bits/stdc++.h>

int main() {
    // Write C++ code here
    int arr[5];
    for (int i=0;i<5;i++){
        std::cin>>arr[i];
    }
    int even=0,odd=0;
    for (int i=0;i<5;i++){
        if (arr[i]%2==0)
            even+=1;
        else
            odd+=1;
    }
    std :: cout<<"even " << even <<"\n";
    std :: cout<<"odd "<<odd;

    return 0;
}
