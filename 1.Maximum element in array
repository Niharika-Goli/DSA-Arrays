//maximum element in array.
#include <bits/stdc++.h>

int main() {
    // Write C++ code here
    int arr[5];
    for (int i=0;i<5;i++){
        std::cin>>arr[i];
    }
    int max=arr[0];
    for (int i=0;i<5;i++){
        if (max<arr[i]){
            max=arr[i];
        }
    }
    std :: cout<<max;

    return 0;
}
