//checks if target present in array.
#include <bits/stdc++.h>

int main() {
    // Write C++ code here
    int arr[5];
    for (int i=0;i<5;i++){
        std::cin>>arr[i];
    }
    int target;
    bool ans=false;
    std::cin>>target;
    for (int i=0;i<5;i++){
        if (arr[i]==target){
            ans=true;
            break;
        }
    }
    std::cout<<(ans ? "true":"false");
    
    return 0;
}
